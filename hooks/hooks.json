{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__github__create_pull_request|mcp__github__merge_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 && python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/ticket_gate.py\" || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
